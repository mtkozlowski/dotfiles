--target=~/.config
--ignore=^\.stowrc$
--ignore=^\.DS_Store$
--ignore=^\.git$
--ignore=^\.githooks$
--ignore=^\.gitignore$
--ignore=^.*\.local\.example$
--ignore=^.*\.local$
--ignore=^\.superpowers$
--ignore=^\.a5c$
--ignore=^home$
# Repo docs, not config. stow's built-in ignore list already covers README.*,
# but not other top-level docs, which would otherwise land in ~/.config.
--ignore=^wireguard-guide\.md$
