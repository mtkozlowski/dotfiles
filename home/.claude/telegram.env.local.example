# Telegram credentials for ~/.claude/hooks/telegram-notify.sh (the /afk command).
#
#   cp ~/dotfiles/home/.claude/telegram.env.local.example ~/.claude/telegram.env.local
#   chmod 600 ~/.claude/telegram.env.local
#
# Get a token from @BotFather. Get the chat id by sending your new bot any message,
# then reading https://api.telegram.org/bot<TOKEN>/getUpdates and taking .result[].message.chat.id
#
# Either value may be a 1Password reference instead of a literal, and the script
# resolves it with `op read` when a message is sent:
#   TELEGRAM_BOT_TOKEN=op://Private/Telegram claude bot/credential
#
# Environment variables of the same name win over this file, so `op run` also works.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
